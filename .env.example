# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# NextAuth
AUTH_SECRET="your-secret-key-min-32-chars"

# Stripe（テストモードで開始 → 動作確認後に本番キー sk_live_xxx に差替）
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Email (nodemailer)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="noreply@datanote.net"
SMTP_PASS="your_smtp_password"
EMAIL_FROM="Creative Base <noreply@datanote.net>"

# Vercel Blob（ファイルアップロード保存先）
# Vercel Dashboard → Storage → Blob → Create で取得
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# ASP S2S Postback URL（初回決済成功時に自動通知）
# プレースホルダ: {affiliateId} {paymentId} {amount} {userId} {timestamp}
# 未設定の場合は自動スキップ（CVタグとCSVで補完）
# レントラックス例: https://www.rentracks.jp/c/postback?sid=15534&aff_id={affiliateId}&order_id={paymentId}&price={amount}
RENTRACKS_POSTBACK_URL=""
# もしも例: https://api.moshimo.com/postback?promotion_id=xxx&aff_id={affiliateId}&order={paymentId}&amount={amount}
MOSHIMO_POSTBACK_URL=""

# App
NEXT_PUBLIC_APP_URL="https://creative-base.vercel.app"
